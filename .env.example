# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# For Docker production: postgresql://fireticket:fireticket@postgres:5432/fireticket
# For Local dev host: postgresql://fireticket:fireticket@localhost:5441/fireticket
DATABASE_URL="postgresql://fireticket:fireticket@postgres:5432/fireticket"

# ── Auth & Security ────────────────────────────────────────────────────────────
# Generate a strong 32+ character random secret: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-char-string-in-production"
NEXTAUTH_URL="http://localhost:3003"
AUTH_TRUST_HOST="true"

# ── Port Binding ───────────────────────────────────────────────────────────────
PORT_BIND=3003
POSTGRES_PORT=5441

# ── Synology NAS / Local Share Integration ──────────────────────────────────────
# Host path where Synology NAS shared folder or NFS/SMB share is mounted
SYNOLOGY_FOLDER="./synology_data"
# Container internal path (default: /synology)
SYNOLOGY_FOLDER_PATH="/synology"

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Set EMAIL_ENABLED=true to activate sending; false logs emails to console only
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="FireTicket <noreply@yourcompany.com>"
EMAIL_ENABLED="false"
