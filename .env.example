# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://fireticket:fireticket@localhost:5432/fireticket"

# ── Auth ───────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="change-this-to-a-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Set EMAIL_ENABLED=true to activate sending; false logs emails to console only
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="FireTicket <noreply@yourcompany.com>"
EMAIL_ENABLED="false"
